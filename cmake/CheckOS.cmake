include(CheckSymbolExists)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(HAVE_Linux TRUE)
    set(HAVE_FreeBSD FALSE)
    set(HAVE_CheriBSD FALSE)
else()
    set(HAVE_Linux False)
    check_symbol_exists(__CheriBSD_version "sys/param.h" HAVE_CheriBSD)
    check_symbol_exists(__FreeBSD_version "sys/param.h" HAVE_FreeBSD)
endif()
